# ==============================================================================
# ZKTeco ADMS Server Configuration
# Copy this file to .env and adjust the values for your environment.
# ==============================================================================

# Server Network Settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# ------------------------------------------------------------------------------
# Timezone Correction Settings (Crucial for ZKTeco Hardware)
# ------------------------------------------------------------------------------
# Many ZKTeco devices contain hardcoded firmware expecting UTC+8 (China Standard Time).
# When the terminal reads the standard HTTP 'Date' header (which is sent in UTC),
# it adds +8 hours to the time regardless of the device's displayed menu settings.
#
# Configure your offsets below to let the server automatically compensate:
DEVICE_UTC_OFFSET_HOURS=8.0      # Factory hardware default for most ZKTeco devices
SERVER_UTC_OFFSET_HOURS=5.5      # Your desired local time (e.g., 5.5 for Sri Lanka/India, 0 for London, -5 for EST)

# Alternatively, specify a direct shift in hours (Shift = DeviceOffset - ServerOffset)
# For example: 8.0 - 5.5 = 2.5 hours
DATE_HEADER_SHIFT_HOURS=2.5

# Per-Device Override (comma-separated list of SerialNumber=ShiftHours)
# Example: DATE_HEADER_SHIFT_SN=JJA1253900189=4.5,ABC9876543210=2.0
DATE_HEADER_SHIFT_SN=

# ------------------------------------------------------------------------------
# Database Settings
# ------------------------------------------------------------------------------
# Engine options: "sqlite" (default, zero-setup) or "mysql"
DB_ENGINE=sqlite
DB_SQLITE_PATH=attendance.db

# MySQL Settings (used only when DB_ENGINE=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=your_secure_password
DB_NAME=attendance_db

# ------------------------------------------------------------------------------
# External Webhook / API Forwarding (Optional)
# ------------------------------------------------------------------------------
# Forward incoming attendance logs to your HRMS, ERP, or Payroll API
WEBHOOK_ENABLED=false
WEBHOOK_URL=https://api.yourcompany.com/v1/attendance-webhook
WEBHOOK_BEARER_TOKEN=
WEBHOOK_TIMEOUT=15
WEBHOOK_BATCH_SIZE=50

